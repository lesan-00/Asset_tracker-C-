@model AssetTracker.Models.Vendors.ViewModels.VendorContractCreateVm

@{
    ViewData["Title"] = "Add Vendor Contract";
}

<div class="contract-drawer-page">
    <div class="contract-drawer-panel">
        <div class="contract-drawer-header">
            <div>
                <h1 class="h4 mb-1">Add Contract</h1>
                <p class="mb-0 text-muted">@Model.VendorName (@Model.VendorCode)</p>
            </div>
            <div class="text-md-end">
                <span class="contract-drawer-ref-label">Contract Ref</span>
                <div class="contract-drawer-ref">@Model.ContractNumber</div>
            </div>
        </div>

        <form asp-action="Create" method="post" class="contract-drawer-body">
            @Html.AntiForgeryToken()
            <input asp-for="VendorId" type="hidden" />
            <input asp-for="VendorName" type="hidden" />
            <input asp-for="VendorCode" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <section class="contract-section">
                <h2 class="contract-section-title">Contract Details</h2>
                <div class="row g-3">
                    <div class="col-md-5">
                        <label asp-for="ContractNumber" class="form-label">Contract Number</label>
                        <input asp-for="ContractNumber" class="form-control contract-ref-input" readonly />
                        <span asp-validation-for="ContractNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="ContractTitle" class="form-label">Contract Title</label>
                        <input asp-for="ContractTitle" class="form-control" />
                        <span asp-validation-for="ContractTitle" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ContractType" class="form-label">Contract Type</label>
                        <select asp-for="ContractType" asp-items="Html.GetEnumSelectList<AssetTracker.Models.Vendors.ContractType>()" class="form-select">
                            <option value="">Select contract type</option>
                        </select>
                        <span asp-validation-for="ContractType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<AssetTracker.Models.Vendors.ContractStatus>()" class="form-select"></select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>
            </section>

            <section class="contract-section">
                <h2 class="contract-section-title">Value &amp; Signing</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ContractValue" class="form-label">Contract Value</label>
                        <div class="input-group">
                            <span class="input-group-text">KES</span>
                            <input asp-for="ContractValue" type="number" step="0.01" min="0" class="form-control" />
                        </div>
                        <span asp-validation-for="ContractValue" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Currency" class="form-label">Currency</label>
                        <select asp-for="Currency" class="form-select">
                            <option value="KES">KES</option>
                            <option value="USD">USD</option>
                            <option value="EUR">EUR</option>
                            <option value="GBP">GBP</option>
                        </select>
                        <span asp-validation-for="Currency" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SignedBy" class="form-label">Signed By</label>
                        <input asp-for="SignedBy" class="form-control" />
                        <span asp-validation-for="SignedBy" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SignedDate" class="form-label">Signed Date</label>
                        <input asp-for="SignedDate" type="date" class="form-control" />
                        <span asp-validation-for="SignedDate" class="text-danger small"></span>
                    </div>
                </div>
            </section>

            <section class="contract-section">
                <h2 class="contract-section-title">Dates &amp; Status</h2>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="StartDate" class="form-label">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EndDate" class="form-label">End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AlertBeforeDays" class="form-label">Alert Before (Days)</label>
                        <input asp-for="AlertBeforeDays" type="number" min="1" class="form-control" />
                        <span asp-validation-for="AlertBeforeDays" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch mt-1">
                            <input asp-for="AutoRenew" class="form-check-input" />
                            <label asp-for="AutoRenew" class="form-check-label">Auto Renew</label>
                        </div>
                    </div>
                </div>
            </section>

            <section class="contract-section">
                <h2 class="contract-section-title">Notes</h2>
                <label asp-for="Notes" class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </section>

            <div class="contract-drawer-actions">
                <button type="submit" class="btn btn-primary">Save Contract</button>
                <a asp-controller="Vendors" asp-action="Details" asp-route-id="@Model.VendorId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
