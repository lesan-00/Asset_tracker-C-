@model AssetTracker.Models.Vendors.ViewModels.PurchaseOrderIndexVm

@{
    ViewData["Title"] = "Purchase Orders";

    static string StatusBadge(AssetTracker.Models.Vendors.PurchaseOrderStatus status) => status switch
    {
        AssetTracker.Models.Vendors.PurchaseOrderStatus.Draft => "text-bg-secondary",
        AssetTracker.Models.Vendors.PurchaseOrderStatus.Submitted => "text-bg-warning",
        AssetTracker.Models.Vendors.PurchaseOrderStatus.Invoiced => "text-bg-warning",
        AssetTracker.Models.Vendors.PurchaseOrderStatus.Paid => "text-bg-success",
        AssetTracker.Models.Vendors.PurchaseOrderStatus.Closed => "text-bg-info",
        AssetTracker.Models.Vendors.PurchaseOrderStatus.Cancelled => "text-bg-danger",
        AssetTracker.Models.Vendors.PurchaseOrderStatus.Approved => "text-bg-primary",
        AssetTracker.Models.Vendors.PurchaseOrderStatus.Received => "text-bg-success",
        _ => "text-bg-secondary"
    };
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Purchase Orders</h1>
        <p class="text-muted mb-0">View purchase orders generated from approved purchase requests.</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <form asp-action="SyncStatuses" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary">Sync Statuses</button>
            </form>
        }
        <a asp-controller="PurchaseRequests" asp-action="Index" class="btn btn-outline-primary">Go to Purchase Requests</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100"><div class="card-body"><div class="text-muted small">Total POs</div><div class="h3 mb-0">@Model.TotalOrders</div></div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100"><div class="card-body"><div class="text-muted small">Open POs</div><div class="h3 mb-0">@Model.OpenOrders</div></div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100"><div class="card-body"><div class="text-muted small">Paid / Closed</div><div class="h3 mb-0">@Model.ReceivedOrders</div></div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100"><div class="card-body"><div class="text-muted small">YTD Spend</div><div class="h3 mb-0">KES @Model.YtdSpend.ToString("N2")</div></div></div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body border-bottom">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-lg-5">
                <input type="search" name="q" value="@Model.Query" class="form-control" placeholder="Search PO number, vendor, linked PR..." />
            </div>
            <div class="col-12 col-lg-4">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="@AssetTracker.Models.Vendors.PurchaseOrderStatus.Draft" selected="@(Model.StatusFilter == AssetTracker.Models.Vendors.PurchaseOrderStatus.Draft ? "selected" : null)">Draft</option>
                    <option value="@AssetTracker.Models.Vendors.PurchaseOrderStatus.Submitted" selected="@(Model.StatusFilter == AssetTracker.Models.Vendors.PurchaseOrderStatus.Submitted ? "selected" : null)">Submitted</option>
                    <option value="@AssetTracker.Models.Vendors.PurchaseOrderStatus.Invoiced" selected="@(Model.StatusFilter == AssetTracker.Models.Vendors.PurchaseOrderStatus.Invoiced ? "selected" : null)">Invoiced</option>
                    <option value="@AssetTracker.Models.Vendors.PurchaseOrderStatus.Paid" selected="@(Model.StatusFilter == AssetTracker.Models.Vendors.PurchaseOrderStatus.Paid ? "selected" : null)">Paid</option>
                    <option value="@AssetTracker.Models.Vendors.PurchaseOrderStatus.Closed" selected="@(Model.StatusFilter == AssetTracker.Models.Vendors.PurchaseOrderStatus.Closed ? "selected" : null)">Closed</option>
                    <option value="@AssetTracker.Models.Vendors.PurchaseOrderStatus.Cancelled" selected="@(Model.StatusFilter == AssetTracker.Models.Vendors.PurchaseOrderStatus.Cancelled ? "selected" : null)">Cancelled</option>
                </select>
            </div>
            <div class="col-12 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>PO Number</th>
                    <th>Order Date</th>
                    <th>Vendor</th>
                    <th>Status</th>
                    <th class="text-end">Amount</th>
                    <th>Linked PR</th>
                    <th>Latest Invoice</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No purchase orders found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@item.PoNumber</td>
                            <td>@item.OrderDate.ToString("dd MMM yyyy")</td>
                            <td>@item.VendorName</td>
                            <td><span class="badge @StatusBadge(item.Status)">@item.Status</span></td>
                            <td class="text-end">@item.Currency @item.TotalAmount.ToString("N2")</td>
                            <td>@item.LinkedPrNumber</td>
                            <td>@item.LinkedInvoiceNumber</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
