@model AssetTracker.Models.StaffProfile

@{
    ViewData["Title"] = "Create Staff Profile";
}

<style>
    .profile-card {
        border: 1px solid #e9ecef;
        border-radius: 16px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
        background-color: #fff;
    }

    .profile-card-body {
        padding: 32px;
    }

    .field-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #6c757d;
        font-weight: 600;
    }

    .form-control,
    .form-select {
        min-height: 44px;
        border-radius: 12px;
    }

    .btn-pill {
        border-radius: 999px;
    }

    .section-title {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #6c757d;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .readonly-field {
        background-color: #f8f9fa;
        color: #495057;
    }
</style>

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="profile-card">
            <div class="profile-card-body">
                <div class="mb-4">
                    <h1 class="display-6 fw-bold mb-1">Create Staff Profile</h1>
                    <p class="text-muted mb-0">Add a new staff member to the system</p>
                </div>

                <hr class="mb-4" />

                <form asp-action="Create">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4"></div>
                    <input asp-for="UserId" type="hidden" />

                    <div class="section-title">Basic Information</div>
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label for="UserEmail" class="form-label field-label">Identity User (Email)</label>
                            <input id="UserEmail"
                                   name="userEmail"
                                   type="email"
                                   class="form-control"
                                   value="@ViewData["SelectedUserEmail"]"
                                   list="identity-users"
                                   placeholder="Enter staff email" />
                            <datalist id="identity-users">
                                @if (ViewData["UserEmails"] is IEnumerable<string> emails)
                                {
                                    foreach (var email in emails)
                                    {
                                        <option value="@email"></option>
                                    }
                                }
                            </datalist>
                            <span asp-validation-for="UserId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="FullName" class="form-label field-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="EmployeeNumber" class="form-label field-label"></label>
                            <input asp-for="EmployeeNumber" class="form-control" />
                            <span asp-validation-for="EmployeeNumber" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="PhoneNumber" class="form-label field-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>

                    <div class="section-title">Work Information</div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Department" class="form-label field-label"></label>
                            <input asp-for="Department" class="form-control" />
                            <span asp-validation-for="Department" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Designation" class="form-label field-label">Designation</label>
                            <input asp-for="Designation" class="form-control" />
                            <span asp-validation-for="Designation" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Location" class="form-label field-label">Location</label>
                            <input asp-for="Location" class="form-control" placeholder="Enter work location" />
                            <span asp-validation-for="Location" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label field-label">Assigned Asset</label>
                            <input id="assigned-asset-text"
                                   type="text"
                                   class="form-control readonly-field"
                                   value="@ViewData["AssignedAssetText"]"
                                   readonly />
                            <small class="text-muted d-block mt-1">Assigned later from the Assignments module.</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                        <button type="submit" class="btn btn-primary btn-pill px-4 py-2">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const emailInput = document.getElementById("UserEmail");
            const assetText = document.getElementById("assigned-asset-text");

            if (!emailInput || !assetText) {
                return;
            }

            async function refreshAssignedAsset() {
                const email = emailInput.value.trim();
                if (!email) {
                    assetText.value = "None";
                    return;
                }

                try {
                    const response = await fetch(`/Staff/LookupAssignedAsset?email=${encodeURIComponent(email)}`);
                    if (!response.ok) {
                        assetText.value = "None";
                        return;
                    }

                    const data = await response.json();
                    assetText.value = data.assignedAsset || "None";
                } catch {
                    assetText.value = "None";
                }
            }

            emailInput.addEventListener("change", refreshAssignedAsset);
            emailInput.addEventListener("blur", refreshAssignedAsset);
        })();
    </script>
}
