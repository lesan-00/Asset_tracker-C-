@model AssetTracker.Models.Assets.EditOperatingSystemVm

@{
    ViewData["Title"] = "Edit Operating System";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h1 class="h4 mb-1">Edit Operating System</h1>
                <p class="text-muted mb-0">Update support lifecycle and installation details for this OS asset.</p>
            </div>
            <div class="card-body">
                <form asp-action="EditOperatingSystem" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input asp-for="Id" type="hidden" />

                    <h2 class="h6 text-muted mb-3">Operating System Information</h2>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="AssetTag" class="form-label"></label>
                            <input asp-for="AssetTag" class="form-control" />
                            <span asp-validation-for="AssetTag" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Edition" class="form-label"></label>
                            <input asp-for="Edition" class="form-control" />
                            <span asp-validation-for="Edition" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Version" class="form-label"></label>
                            <input asp-for="Version" class="form-control" />
                            <span asp-validation-for="Version" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="BuildNumber" class="form-label"></label>
                            <input asp-for="BuildNumber" class="form-control" />
                            <span asp-validation-for="BuildNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<AssetTracker.Models.SoftwareStatus>()" class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PurchaseDate" class="form-label"></label>
                            <input asp-for="PurchaseDate" type="date" class="form-control" />
                            <span asp-validation-for="PurchaseDate" class="text-danger"></span>
                        </div>
                    </div>

                    <h2 class="h6 text-muted mb-3">Licensing and Support</h2>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="VendorId" class="form-label">Vendor</label>
                            <select asp-for="VendorId" asp-items="ViewBag.VendorId" class="form-select searchable-vendor" data-placeholder="Search vendor...">
                                <option value="">No vendor</option>
                            </select>
                            <span asp-validation-for="VendorId" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="LicenseType" class="form-label"></label>
                            <input asp-for="LicenseType" class="form-control" />
                            <span asp-validation-for="LicenseType" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="LicenseKey" class="form-label"></label>
                            <input asp-for="LicenseKey" class="form-control" />
                            <span asp-validation-for="LicenseKey" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SupportEndDate" class="form-label"></label>
                            <input asp-for="SupportEndDate" type="date" class="form-control" />
                            <span asp-validation-for="SupportEndDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PatchStatus" class="form-label"></label>
                            <input asp-for="PatchStatus" class="form-control" />
                            <span asp-validation-for="PatchStatus" class="text-danger"></span>
                        </div>
                    </div>

                    <h2 class="h6 text-muted mb-3">Installation</h2>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="InstalledOn" class="form-label"></label>
                            <input asp-for="InstalledOn" class="form-control" />
                            <span asp-validation-for="InstalledOn" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
