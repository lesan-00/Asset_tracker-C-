@model AssetTracker.Models.Assets.AssetIndexVm

@{
    ViewData["Title"] = "Assets";

    static string Readable(string? key)
    {
        if (string.IsNullOrWhiteSpace(key))
        {
            return "Not provided";
        }

        return string.Join(' ', key.Split('-', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => char.ToUpperInvariant(part[0]) + part[1..]));
    }

    static string BuildPath(AssetTracker.Models.Asset asset)
    {
        if (asset.AssetType == AssetTracker.Models.AssetType.MobilePhone)
        {
            return "Hardware / Mobile Phones";
        }

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(asset.TopLevelCategory))
        {
            parts.Add(Readable(asset.TopLevelCategory));
        }

        if (!string.IsNullOrWhiteSpace(asset.Category))
        {
            parts.Add(Readable(asset.Category));
        }

        if (!string.IsNullOrWhiteSpace(asset.SubCategory))
        {
            parts.Add(Readable(asset.SubCategory));
        }

        return parts.Count == 0 ? "Uncategorized" : string.Join(" / ", parts);
    }

    static string? ResolveSoftwareCreateAction(string? categoryKey)
    {
        return categoryKey?.ToLowerInvariant() switch
        {
            "licensed-applications" => "CreateLicensedApplication",
            "operating-systems" => "CreateOperatingSystem",
            "subscriptions" => "CreateSubscription",
            "open-source" => "CreateOpenSource",
            _ => null
        };
    }

    static string? ResolveSoftwareEditAction(AssetTracker.Models.Asset asset)
    {
        var category = asset.SoftwareCategory?.ToString() switch
        {
            "LicensedApplications" => "licensed-applications",
            "OperatingSystems" => "operating-systems",
            "Subscriptions" => "subscriptions",
            "OpenSource" => "open-source",
            _ => asset.Category
        };

        return ResolveSoftwareCreateAction(category)?.Replace("Create", "Edit", StringComparison.Ordinal);
    }

    static string SoftwareStatusClass(AssetTracker.Models.SoftwareStatus? status) => status switch
    {
        AssetTracker.Models.SoftwareStatus.Active => "text-bg-success",
        AssetTracker.Models.SoftwareStatus.PendingRenewal => "text-bg-warning",
        AssetTracker.Models.SoftwareStatus.Expired => "text-bg-danger",
        AssetTracker.Models.SoftwareStatus.Suspended => "text-bg-secondary",
        AssetTracker.Models.SoftwareStatus.Trial => "text-bg-info",
        AssetTracker.Models.SoftwareStatus.Revoked => "text-bg-dark",
        AssetTracker.Models.SoftwareStatus.Retired => "text-bg-dark",
        _ => "text-bg-secondary"
    };

    static string SoftwareRelevantDate(AssetTracker.Models.Asset asset)
    {
        if (asset.SoftwareCategory == AssetTracker.Models.SoftwareCategory.OperatingSystems)
        {
            return asset.SupportEndDate?.ToString("dd MMM yyyy") ?? "Not set";
        }

        return asset.ExpiryDate?.ToString("dd MMM yyyy") ?? "Not set";
    }

    var createAction = "Create";
    if (Model.IsSoftwareScope)
    {
        createAction = ResolveSoftwareCreateAction(Model.Selection.Category) ?? "CreateSoftware";
    }

    var searchPlaceholder = Model.IsPhysicalScope
        ? "Search by asset tag, type, status, or location"
        : "Search by tag, name, version, vendor, location...";

    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

@if (TempData["AssetSuccess"] is string successMessage)
{
    <div class="alert alert-success mb-3" role="alert">@successMessage</div>
}

@if (TempData["AssetError"] is string errorMessage)
{
    <div class="alert alert-warning mb-3" role="alert">@errorMessage</div>
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Heading</h1>
        <p class="text-muted mb-0">Manage assets by category and lifecycle state.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge text-bg-light border">Total: @Model.TotalCount</span>
        @if (User.IsInRole("Admin"))
        {
            if (Model.IsSoftwareScope)
            {
                <a asp-action="@createAction" class="btn btn-primary">Add Asset</a>
            }
            else
            {
                <a asp-action="Create"
                   asp-route-group="@Model.Selection.TopLevelCategory"
                   asp-route-category="@Model.Selection.Category"
                   asp-route-subCategory="@Model.Selection.SubCategory"
                   class="btn btn-primary">Add Asset</a>
            }
        }
    </div>
</div>

@if (Model.Breadcrumbs.Count > 1)
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            @for (var i = 0; i < Model.Breadcrumbs.Count; i++)
            {
                var crumb = Model.Breadcrumbs[i];
                if (crumb.IsActive)
                {
                    <li class="breadcrumb-item active" aria-current="page">@crumb.Label</li>
                }
                else
                {
                    <li class="breadcrumb-item"><a href="@crumb.Url">@crumb.Label</a></li>
                }
            }
        </ol>
    </nav>
}

<div class="card shadow-sm border-0">
    <div class="card-body border-bottom">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <input type="hidden" name="group" value="@Model.Selection.TopLevelCategory" />
            <input type="hidden" name="category" value="@Model.Selection.Category" />
            <input type="hidden" name="subCategory" value="@Model.Selection.SubCategory" />
            <div class="col-12 col-md-9">
                <input type="search"
                       name="q"
                       value="@Model.Query"
                       class="form-control"
                       placeholder="@searchPlaceholder" />
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Search</button>
                <a asp-action="Index"
                   asp-route-group="@Model.Selection.TopLevelCategory"
                   asp-route-category="@Model.Selection.Category"
                   asp-route-subCategory="@Model.Selection.SubCategory"
                   class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
    <div class="table-responsive">
        @if (Model.IsSoftwareScope)
        {
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Software Category</th>
                        <th>Version / Plan</th>
                        <th>Vendor</th>
                        <th>Status</th>
                        <th>Relevant Date</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No software assets found for the current filter.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var editAction = ResolveSoftwareEditAction(item);
                            var versionOrPlan = item.SoftwareCategory == AssetTracker.Models.SoftwareCategory.Subscriptions
                                ? (string.IsNullOrWhiteSpace(item.PlanOrTier) ? "Not set" : item.PlanOrTier)
                                : (string.IsNullOrWhiteSpace(item.SoftwareVersion) ? "Not set" : item.SoftwareVersion);
                            var isRetired = item.Status == AssetTracker.Models.AssetStatus.Retired
                                            || item.SoftwareStatus == AssetTracker.Models.SoftwareStatus.Retired;

                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(item.SoftwareName) ? item.Model : item.SoftwareName)</td>
                                <td>@Readable(item.Category)</td>
                                <td>@versionOrPlan</td>
                                <td>
                                    @if (item.VendorId.HasValue && item.Vendor is not null)
                                    {
                                        <a asp-controller="Vendors" asp-action="Details" asp-route-id="@item.VendorId" class="text-decoration-none">@item.Vendor.CompanyName</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><span class="badge @SoftwareStatusClass(item.SoftwareStatus)">@((item.SoftwareStatus?.ToString()) ?? "Not set")</span></td>
                                <td>@SoftwareRelevantDate(item)</td>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        if (!string.IsNullOrWhiteSpace(editAction))
                                        {
                                            <a asp-action="@editAction" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                        }
                                        if (!isRetired)
                                        {
                                            <form asp-action="Retire" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                <button type="submit" class="btn btn-sm btn-outline-dark">Retire Asset</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete Permanently</a>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
        else if (Model.IsPhysicalScope)
        {
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Asset Tag</th>
                        <th>Asset Type</th>
                        <th>Status</th>
                        <th>Location</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No physical assets found for the current filter.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var isRetired = item.Status == AssetTracker.Models.AssetStatus.Retired;
                            var assetStatusClass = item.Status switch
                            {
                                AssetTracker.Models.AssetStatus.InStock => "text-bg-success",
                                AssetTracker.Models.AssetStatus.Assigned => "text-bg-primary",
                                AssetTracker.Models.AssetStatus.InRepair => "text-bg-warning",
                                AssetTracker.Models.AssetStatus.Retired => "text-bg-dark",
                                _ => "text-bg-secondary"
                            };

                            <tr>
                                <td>@item.AssetTag</td>
                                <td>@Html.DisplayFor(_ => item.AssetType)</td>
                                <td><span class="badge @assetStatusClass">@item.Status</span></td>
                                <td>@item.Location</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                        if (!isRetired)
                                        {
                                            <form asp-action="Retire" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                <button type="submit" class="btn btn-sm btn-outline-dark">Retire Asset</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete Permanently</a>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
        else
        {
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Asset Tag</th>
                        <th>Asset Type</th>
                        <th>Brand</th>
                        <th>Model</th>
                        <th>Serial Number</th>
                        <th>Taxonomy</th>
                        <th>Vendor</th>
                        <th>Status</th>
                        <th>Location</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="11" class="text-center text-muted py-4">No assets found for the current filter.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var isRetired = item.Status == AssetTracker.Models.AssetStatus.Retired;
                            var assetStatusClass = item.Status switch
                            {
                                AssetTracker.Models.AssetStatus.InStock => "text-bg-success",
                                AssetTracker.Models.AssetStatus.Assigned => "text-bg-primary",
                                AssetTracker.Models.AssetStatus.InRepair => "text-bg-warning",
                                AssetTracker.Models.AssetStatus.Retired => "text-bg-dark",
                                _ => "text-bg-secondary"
                            };

                            <tr>
                                <td>@item.AssetTag</td>
                                <td>@Html.DisplayFor(_ => item.AssetType)</td>
                                <td>@item.Brand</td>
                                <td>@item.Model</td>
                                <td>@item.SerialNumber</td>
                                <td>@BuildPath(item)</td>
                                <td>
                                    @if (item.VendorId.HasValue && item.Vendor is not null)
                                    {
                                        <a asp-controller="Vendors" asp-action="Details" asp-route-id="@item.VendorId" class="text-decoration-none">@item.Vendor.CompanyName</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><span class="badge @assetStatusClass">@item.Status</span></td>
                                <td>@item.Location</td>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                        if (!isRetired)
                                        {
                                            <form asp-action="Retire" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                <button type="submit" class="btn btn-sm btn-outline-dark">Retire Asset</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete Permanently</a>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
</div>
