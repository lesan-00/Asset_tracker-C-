@model AssetTracker.Models.Vendors.ViewModels.VendorSupportTicketCreateVm

@{
    ViewData["Title"] = "Create Vendor Support Ticket";
}

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h1 class="h4 mb-0">Create Support Ticket</h1>
                <p class="text-muted mb-0 small">@ViewData["VendorLabel"]</p>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <input asp-for="VendorId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Type" class="form-label">Type</label>
                            <select asp-for="Type" asp-items="Html.GetEnumSelectList<AssetTracker.Models.Vendors.SupportTicketType>()" class="form-select"></select>
                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label">Status</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<AssetTracker.Models.Vendors.SupportTicketStatus>()" class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssetId" class="form-label">Related Asset</label>
                            <select asp-for="AssetId" asp-items="ViewBag.AssetId" class="form-select">
                                <option value="">No asset link</option>
                            </select>
                            <span asp-validation-for="AssetId" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Title" class="form-label">Title</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OpenedDate" class="form-label">Opened Date</label>
                            <input asp-for="OpenedDate" type="date" class="form-control" />
                            <span asp-validation-for="OpenedDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ClosedDate" class="form-label">Closed Date</label>
                            <input asp-for="ClosedDate" type="date" class="form-control" />
                            <span asp-validation-for="ClosedDate" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Ticket</button>
                        <a asp-controller="Vendors" asp-action="Details" asp-route-id="@Model.VendorId" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
