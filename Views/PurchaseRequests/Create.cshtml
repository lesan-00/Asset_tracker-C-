@model AssetTracker.Models.Vendors.ViewModels.PurchaseRequestUpsertVm

@{
    ViewData["Title"] = "New Purchase Request";
    ViewData["FormAction"] = "Create";
    ViewData["CancelAction"] = "Index";
    ViewData["IsEdit"] = false;
}

<div class="row justify-content-center">
    <div class="col-12 col-xxl-11">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h1 class="h4 mb-1">Create Purchase Request</h1>
                <p class="text-muted mb-0">Save as draft or submit for approval before creating a purchase order.</p>
            </div>
            <div class="card-body">
                <partial name="_Form" model="Model" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
